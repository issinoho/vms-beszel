# Copy to tools/nodes.conf (not committed) and adjust.
# The SSH key is $VMS_SSH_KEY, default ~/.ssh/vms_ed25519.
# vms-beszel needs no sibling dependency trees (only VSI's SSL3 kit), so it
# has a work directory of its own.
# name  arch    host          port  user      vms_workdir                       sftp_workdir
ia64    IA64    <ia64-host>   22    username  DISK$USER:[USERNAME.VMS_BESZEL]   vms_beszel
x86     X86_64  <x86-host>    22    username  DISK$USER:[USERNAME.VMS_BESZEL]   vms_beszel
